      let sacudidas = 0;
      const porSacudida = Math.cbrt(prob);
      for (let i = 0; i < 3; i++) { if (Math.random() < porSacudida) sacudidas += 1; else break; }
      const atrapada = sacudidas === 3;
      ev.push(['esfera', sacudidas, atrapada]);
