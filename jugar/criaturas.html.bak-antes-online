      else if (e[0] === 'evolucion') ev.push(['msg', '¿Qué? ¡' + e[1] + ' está cambiando de forma!'], ['evolucion', e[1], e[2]], ['hp', 'jugador'], ['msg', '¡' + e[1] + ' evolucionó en ' + e[2] + '!']);
