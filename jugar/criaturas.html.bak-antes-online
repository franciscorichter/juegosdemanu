    return true;
  }
  manejarTecla(k) {
    const kk = k.length === 1 ? k.toLowerCase() : k;
    if (this.estado === 'titulo') {
      this.menu.mover(k);
      if (kk === 'l') this.cargar();
      else if (k === 'Enter') {
        sonar('seleccion');
        if (this.menu.i === 0) this.estado = 'elegir';
        else if (this.menu.i === 1) this.cargar();
        else { try { localStorage.removeItem('criaturas-partida'); } catch (e) {} this.aviso = ['Partida guardada borrada.', 2]; }
      }
    } else if (this.estado === 'elegir') {
      this.menuInicial.mover(k);
      if (k === 'Enter') { sonar('captura'); this.nuevaPartida(INICIALES[this.menuInicial.i]); }
      else if (k === 'Escape') this.estado = 'titulo';
    } else if (this.estado === 'mapa') {
      if (this.mensajes.length) { if (k === 'Enter') { this.mensajes.shift(); sonar('seleccion'); } return; }
      if (kk === 'g') this.guardar();
      else if (kk === 'l') this.cargar();
      else if (k === 'Escape' || kk === 'm') { this.estado = 'pausa'; this.menuPausa.i = 0; sonar('seleccion'); }
      else if (k === 'Enter') this.interactuar();
    } else if (this.estado === 'pausa') this.manejarPausa(k);
    else if (this.estado === 'equipo') this.manejarEquipo(k);
    else if (this.estado === 'mochila') this.manejarMochila(k);
    else if (this.estado === 'batalla') { if (this.batalla) this.batalla.tecla(k); }
    else if (this.estado === 'final') { if (k === 'Enter') this.estado = 'mapa'; }
  }
  manejarPausa(k) {
    const kk = k.length === 1 ? k.toLowerCase() : k;
    this.menuPausa.mover(k);
    if (k === 'Escape' || kk === 'm') this.estado = 'mapa';
    else if (kk === 'g') this.guardar();
    else if (kk === 'l') this.cargar();
    else if (k === 'Enter') {
      sonar('seleccion');
      const op = this.menuPausa.i;
      if (op === 0) { this.menuEquipo = new Menu([...this.partida.equipo]); this.intercambio = null; this.objetoElegido = null; this.estado = 'equipo'; }
      else if (op === 1) { this.menuMochila = new Menu(this.partida.mochila.lista()); this.estado = 'mochila'; }
      else if (op === 2) this.guardar();
      else if (op === 3) this.cargar();
      else if (op === 4) this.estado = 'mapa';
      else this.estado = 'titulo';
    }
  }
  manejarEquipo(k) {
    this.menuEquipo.mover(k);
    if (k === 'Escape') { this.estado = this.objetoElegido ? 'mochila' : 'pausa'; this.objetoElegido = null; this.intercambio = null; }
    else if (k === 'Enter') {
      const i = this.menuEquipo.i, eq = this.partida.equipo;
      if (this.objetoElegido) this.usarObjetoMapa(this.objetoElegido, eq[i]);
      else if (this.intercambio === null) { this.intercambio = i; sonar('seleccion'); }
      else { [eq[this.intercambio], eq[i]] = [eq[i], eq[this.intercambio]]; this.menuEquipo = new Menu([...eq]); this.menuEquipo.i = i; this.intercambio = null; sonar('seleccion'); }
    }
  }
  manejarMochila(k) {
    this.menuMochila.mover(k);
    if (k === 'Escape') this.estado = 'pausa';
    else if (k === 'Enter' && this.menuMochila.opciones.length) {
      const nombre = this.menuMochila.opciones[this.menuMochila.i][0];
      if (OBJETOS[nombre].tipo === 'esfera') { this.aviso = ['Las esferas se usan en batalla.', 2]; sonar('escape'); }
      else { this.objetoElegido = nombre; this.menuEquipo = new Menu([...this.partida.equipo]); this.estado = 'equipo'; }
    }
  }
  usarObjetoMapa(nombre, c) {
    const obj = OBJETOS[nombre];
    if (obj.tipo === 'curar') {
      if (c.ko || c.hp >= c.hpMax) { this.aviso = ['No le hace falta.', 1.5]; sonar('escape'); return; }
      c.curar(obj.valor);
    } else if (obj.tipo === 'estado') {
      if (c.estado === null) { this.aviso = ['No le hace falta.', 1.5]; sonar('escape'); return; }
      c.estado = null; c.turnosDormido = 0;
    }
    this.partida.mochila.quitar(nombre); sonar('curar');
    this.aviso = ['Usaste ' + nombre + ' en ' + c.nombre + '.', 2];
    this.objetoElegido = null; this.menuMochila = new Menu(this.partida.mochila.lista()); this.estado = 'mochila';
  }
  // ENTER en el mapa: mira la casilla de enfrente.
  interactuar() {
    const fx = this.x + this.mirando[0], fy = this.y + this.mirando[1], ch = this.mapa.casilla(fx, fy);
    if (this.mapa.letreros.has(fx + ',' + fy)) { this.mensajes.push(this.mapa.letreros.get(fx + ',' + fy)); sonar('seleccion'); }
    else if ('123K'.includes(ch)) this.hablarEntrenador(ch);
  }
  hablarEntrenador(letra) {
    const datos = ENTRENADORES[letra];
    if (this.partida.vencidos.includes(letra)) { this.mensajes.push(datos.nombre + ': ' + datos.despues); return; }
    if (letra === 'K' && this.partida.vencidos.filter(v => v !== 'K').length < 3) { this.mensajes.push(datos.nombre + ': Vuelve cuando hayas vencido a los 3 entrenadores.'); return; }
    if (!this.partida.tieneVivas()) { this.mensajes.push('Tus criaturas están agotadas. Ve al centro de curación primero.'); return; }
    this.empezarBatalla(datos.equipo.map(([e, n]) => new Criatura(e, n)), letra);
  }
  mover(dx, dy, corriendo) {
    this.mirando = [dx, dy];
    const nx = this.x + dx, ny = this.y + dy, ch = this.mapa.casilla(nx, ny);
    if (this.mapa.solida(nx, ny)) {
      if (this.mapa.letreros.has(nx + ',' + ny) || '123K'.includes(ch)) { if (this.pasoTimer <= 0) { this.interactuar(); this.pasoTimer = 0.4; } }
      return;
    }
    this.x = nx; this.y = ny;
    this.pasoTimer = corriendo ? PASO_CORRER : PASO_SEG;
    if (ch === '+') this.curarEnCentro();
    else if (ch in PASTO && this.partida.tieneVivas() && Math.random() < PROB_ENCUENTRO) {
      const [nmin, nmax, especies] = PASTO[ch];
      this.empezarBatalla([new Criatura(elegir(especies), azarEntero(nmin, nmax))], null, ch);
    }
  }
  curarEnCentro() { this.partida.curarEquipo(); this.puntoCuracion = [this.x, this.y]; this.aviso = ['¡Tu equipo está curado!', 2]; sonar('curar'); }
  empezarBatalla(enemigos, entrenador = null, pasto = null) {
    const datos = entrenador ? ENTRENADORES[entrenador] : null;
    const b = new Batalla(this.partida.equipo, this.partida.mochila, enemigos, datos, this.partida.caja);
    this.batallaPendiente = [b, entrenador, pasto];
    this.transicion = 0.01;
    sonar('encuentro');
  }
  fondoBatalla(pasto) {
    const clave = pasto || '.';
    if (!this.fondos[clave]) {
      const s = document.createElement('canvas'); s.width = ANCHO; s.height = ALTO;
      const g = s.getContext('2d');
      const [arriba, abajo] = { ',': [[170, 220, 250], [130, 200, 110]], ';': [[150, 200, 240], [80, 160, 80]], '"': [[110, 150, 200], [50, 110, 60]], '.': [[230, 210, 170], [190, 160, 110]] }[clave];
      const grad = g.createLinearGradient(0, 0, 0, ALTO);
      grad.addColorStop(0, rgb(arriba)); grad.addColorStop(1, rgb(abajo));
      g.fillStyle = grad; g.fillRect(0, 0, ANCHO, ALTO);
      this.fondos[clave] = s;
    }
    return this.fondos[clave];
  }
  terminarBatalla() {
    const b = this.batalla.b, letra = this.batallaLetra;
    this.batalla = null; this.estado = 'mapa';
    if (b.resultado === 'victoria' && letra) {
      if (!this.partida.vencidos.includes(letra)) this.partida.vencidos.push(letra);
      if (letra === 'K') { this.partida.campeon = true; this.estado = 'final'; }
    } else if (b.resultado === 'derrota') {
      this.partida.curarEquipo();
      [this.x, this.y] = this.puntoCuracion;
      this.mensajes.push('Te quedaste sin criaturas... Corriste al centro de curación y ya están bien.');
      if (letra) this.mensajes.push('Consejo: entrena en el pasto y vuelve más fuerte.');
    }
  }
  actualizar(dt) {
    this.t += dt;
    if (this.aviso[1] > 0) this.aviso[1] -= dt;
    if (this.transicion > 0) {
      this.transicion += dt;
      if (this.transicion > 0.7 && this.batallaPendiente) {
        const [b, letra, pasto] = this.batallaPendiente;
        this.batalla = new PantallaBatalla(this, b, this.fondoBatalla(pasto));
        this.batallaLetra = letra; this.batallaPendiente = null; this.estado = 'batalla';
      }
      if (this.transicion > 1.0) this.transicion = 0;
      return;
    }
    if (this.estado === 'mapa') {
      this.pasoTimer -= dt;
      if (!this.mensajes.length && this.pasoTimer <= 0) {
        const corriendo = !!teclas.Shift;
        if (teclas.ArrowLeft) this.mover(-1, 0, corriendo);
        else if (teclas.ArrowRight) this.mover(1, 0, corriendo);
        else if (teclas.ArrowUp) this.mover(0, -1, corriendo);
        else if (teclas.ArrowDown) this.mover(0, 1, corriendo);
      }
    } else if (this.estado === 'batalla' && this.batalla) {
      this.batalla.actualizar(dt);
      if (this.batalla.terminado) this.terminarBatalla();
    }
  }
  dibujar() {
    const s = ctx;
    if (this.estado === 'titulo') this.dibujarTitulo(s);
    else if (this.estado === 'elegir') this.dibujarElegir(s);
    else if (['mapa', 'pausa', 'equipo', 'mochila'].includes(this.estado)) {
      this.dibujarMapa(s);
      if (this.estado === 'pausa') this.dibujarPausa(s);
      else if (this.estado === 'equipo') this.dibujarEquipo(s);
      else if (this.estado === 'mochila') this.dibujarMochila(s);
    } else if (this.estado === 'batalla' && this.batalla) this.batalla.dibujar(s);
    else if (this.estado === 'final') this.dibujarFinal(s);
    if (this.aviso[1] > 0) {
      const w = medir(this.aviso[0], 22) + 30;
      caja(s, ANCHO / 2 - w / 2, 15, w, 40); texto(s, this.aviso[0], ANCHO / 2, 24, 22, NEGRO, true);
    }
    if (this.transicion > 0) {
      let k = this.transicion < 0.7 ? this.transicion / 0.7 : 1 - (this.transicion - 0.7) / 0.3;
      k = Math.max(0, Math.min(1, k));
      rect(s, 0, 0, ANCHO, ALTO, `rgba(25,25,35,${k})`);
      if (this.transicion < 0.7) for (let i = 0; i < trunc(k * 12); i++) rect(s, 0, i * ALTO / 12, ANCHO, ALTO / 24, NEGRO);   // rayas que se cierran
    }
  }
  dibujarTitulo(s) {
    rect(s, 0, 0, ANCHO, ALTO, 'rgb(40,60,100)');
    Object.keys(ESPECIES).forEach((esp, i) => {
      const ang = this.t * 0.3 + i * Math.PI * 2 / 12;
      dibujarCriatura(s, esp, ANCHO / 2 + Math.cos(ang) * 380, ALTO / 2 + Math.sin(ang) * 220, 70, this.t, Math.cos(ang) < 0 ? 1 : -1);
    });
    texto(s, 'CRIATURAS', ANCHO / 2, 150, 80, 'rgb(250,230,120)', true, 'rgb(30,30,50)');
    texto(s, 'un juego de Manu', ANCHO / 2, 240, 26, BLANCO, true);
    this.menu.opciones.forEach((op, i) => {
      const y = 330 + i * 50;
      if (i === this.menu.i) texto(s, '▶', ANCHO / 2 - 120, y, 30, 'rgb(250,230,120)');
      texto(s, op, ANCHO / 2 - 80, y, 30, BLANCO);
    });
    texto(s, 'Flechas: moverse   ENTER: elegir', ANCHO / 2, ALTO - 50, 20, 'rgb(180,190,210)', true);
  }
  dibujarElegir(s) {
    rect(s, 0, 0, ANCHO, ALTO, 'rgb(230,235,225)');
    texto(s, 'Elige tu primera criatura', ANCHO / 2, 50, 40, NEGRO, true);
    this.menuInicial.opciones.forEach((esp, i) => {
      const x = ANCHO / 2 + (i - 1) * 300, elegido = i === this.menuInicial.i, tipo = ESPECIES[esp].tipo;
      rectRedondo(s, x - 130, 130, 260, 400, 14, elegido ? 'rgb(255,255,255)' : 'rgb(240,240,235)');
      rectRedondo(s, x - 130, 130, 260, 400, 14, elegido ? rgb(COLOR_TIPO[tipo]) : GRIS, 5);
      dibujarCriatura(s, esp, x, 280, elegido ? 170 : 140, this.t);
      texto(s, esp, x, 380, 32, NEGRO, true); texto(s, NOMBRE_TIPO[tipo], x, 420, 22, rgb(COLOR_TIPO[tipo]), true);
      partirTexto(ESPECIES[esp].descripcion, 18, 230).forEach((l, j) => texto(s, l, x, 455 + j * 22, 18, GRIS, true));
    });
    texto(s, 'Izquierda / derecha para mirar, ENTER para elegir', ANCHO / 2, ALTO - 50, 22, GRIS, true);
  }
  dibujarMapa(s) {
    let camX = this.x * TILE - ANCHO / 2 + TILE / 2, camY = this.y * TILE - ALTO / 2 + TILE / 2;
    camX = Math.max(0, Math.min(this.mapa.ancho * TILE - ANCHO, camX)); camY = Math.max(0, Math.min(this.mapa.alto * TILE - ALTO, camY));
    rect(s, 0, 0, ANCHO, ALTO, 'rgb(30,80,40)');
    this.mapa.dibujar(s, camX, camY, this.t, this.partida.vencidos);
    const bob = this.pasoTimer > 0 ? trunc(Math.abs(Math.sin(this.t * 12)) * 3) : 0;
    dibujarPersona(s, this.x * TILE - camX + TILE / 2, this.y * TILE - camY + TILE / 2 - bob, [60, 120, 220], false, false, this.t, !(this.mirando[0] === 0 && this.mirando[1] === -1));
    this.partida.equipo.forEach((c, i) => {
      const px = 15 + i * 46;
      rectRedondo(s, px, ALTO - 60, 42, 48, 6, 'rgb(255,255,255)');
      dibujarCriatura(s, c.especie, px + 21, ALTO - 42, 26, this.t);
      const frac = c.hp / c.hpMax; barra(s, px + 4, ALTO - 18, 34, 5, frac, colorHp(frac));
    });
    if (this.mensajes.length) {
      caja(s, 20, ALTO - 150, ANCHO - 40, 130);
      partirTexto(this.mensajes[0], 24, ANCHO - 90).forEach((l, i) => texto(s, l, 40, ALTO - 135 + i * 30, 24));
      if (trunc(this.t * 3) % 2) texto(s, '▼ ENTER', ANCHO - 130, ALTO - 50, 18, AZUL_CAJA);
    } else {
      const ayuda = 'ESC: menú   G: guardar   L: cargar';
      texto(s, ayuda, ANCHO - 15 - medir(ayuda, 16), ALTO - 25, 16, BLANCO, false, NEGRO);
      const insignias = this.partida.vencidos.filter(v => v !== 'K').length;
      const t2 = 'Entrenadores vencidos: ' + insignias + '/3' + (this.partida.campeon ? '   ★ CAMPEÓN' : '');
      texto(s, t2, ANCHO - 15 - medir('Entrenadores vencidos: 0/3   ★ CAMPEÓN', 18), 15, 18, BLANCO, false, NEGRO);
    }
  }
  dibujarPausa(s) {
    const rx = ANCHO / 2 - 160;
    caja(s, rx, 120, 320, 340);
    texto(s, 'MENÚ', ANCHO / 2, 135, 30, NEGRO, true);
    this.menuPausa.opciones.forEach((op, i) => {
      const y = 190 + i * 42;
      if (i === this.menuPausa.i) texto(s, '▶', rx + 25, y + 3, 22, AZUL_CAJA);
      texto(s, op, rx + 55, y, 24);
    });
  }
  dibujarEquipo(s) {
    caja(s, 20, 20, ANCHO - 40, ALTO - 40, 'rgb(240,244,250)');
    const titulo = this.objetoElegido ? '¿A quién le das ' + this.objetoElegido + '?'
      : this.intercambio !== null ? '¿Con quién cambias a ' + this.partida.equipo[this.intercambio].nombre + '?'
      : 'Tu equipo  (ENTER dos veces para cambiar el orden; la primera pelea)';
    texto(s, titulo, 40, 30, 22);
    const m = this.menuEquipo;
    m.opciones.forEach((c, i) => {
      const px = 50 + (i % 2) * 450, py = 70 + trunc(i / 2) * 160, marcado = i === m.i || i === this.intercambio;
      rectRedondo(s, px, py, 420, 145, 8, marcado ? 'rgb(215,225,245)' : 'rgb(250,250,250)');
      rectRedondo(s, px, py, 420, 145, 8, marcado ? AZUL_CAJA : GRIS, 3);
      dibujarCriatura(s, c.especie, px + 60, py + 70, 90, this.t);
      texto(s, c.nombre, px + 125, py + 12, 24);
      texto(s, 'Nv ' + c.nivel + '   ' + NOMBRE_TIPO[c.tipo] + '   ' + textoEstado(c), px + 125, py + 42, 18, GRIS);
      const frac = c.hp / c.hpMax;
      barra(s, px + 125, py + 68, 200, 12, frac, colorHp(frac)); texto(s, c.hp + '/' + c.hpMax, px + 335, py + 62, 18);
      const [a, b] = c.expSiguiente(); barra(s, px + 125, py + 90, 200, 6, b ? a / b : 0, AZUL_EXP);
      texto(s, c.ataques.slice(0, 2).join('  '), px + 125, py + 100, 15, GRIS); texto(s, c.ataques.slice(2).join('  '), px + 125, py + 118, 15, GRIS);
    });
    if (this.partida.caja.length) texto(s, 'En la caja: ' + this.partida.caja.length + ' criatura(s)', 40, ALTO - 50, 18, GRIS);
    texto(s, 'ESC: volver', ANCHO - 140, ALTO - 50, 18, GRIS);
  }
  dibujarMochila(s) {
    const rx = ANCHO / 2 - 250, ry = 100, rb = ry + 400;
    caja(s, rx, ry, 500, 400);
    texto(s, 'MOCHILA', ANCHO / 2, 115, 30, NEGRO, true);
    const m = this.menuMochila;
    if (!m.opciones.length) texto(s, 'Está vacía.', ANCHO / 2, 200, 24, GRIS, true);
    m.opciones.forEach(([nombre, n], i) => {
      const y = 170 + i * 40;
      if (i === m.i) texto(s, '▶', rx + 30, y + 3, 22, AZUL_CAJA);
      texto(s, nombre + '  x' + n, rx + 60, y, 24);
    });
    if (m.opciones.length) texto(s, OBJETOS[m.opciones[m.i][0]].descripcion, ANCHO / 2, rb - 70, 20, AZUL_CAJA, true);
    texto(s, 'ENTER: usar   ESC: volver', ANCHO / 2, rb - 40, 18, GRIS, true);
  }
  dibujarFinal(s) {
    rect(s, 0, 0, ANCHO, ALTO, 'rgb(250,230,120)');
    texto(s, '¡ERES EL NUEVO CAMPEÓN!', ANCHO / 2, 80, 60, 'rgb(120,60,20)', true, 'rgb(255,250,200)');
    const eq = this.partida.equipo;
    eq.forEach((c, i) => {
      const x = ANCHO / 2 + (i - (eq.length - 1) / 2) * 150, y = 330 + Math.sin(this.t * 4 + i) * 15;
      dibujarCriatura(s, c.especie, x, y, 120, this.t); texto(s, c.nombre + ' Nv ' + c.nivel, x, 420, 18, NEGRO, true);
    });
    texto(s, 'Puedes seguir jugando, atrapando y entrenando. ¡Gracias por jugar!', ANCHO / 2, 520, 24, NEGRO, true);
    texto(s, 'ENTER para volver al mapa', ANCHO / 2, 570, 20, GRIS, true);
  }
}

// ---------- Teclas y bucle ----------
const teclas = {};
const juego = new Juego();
document.addEventListener('keydown', (e) => {
  encenderAudio();
  if (e.key.startsWith('Arrow') || e.key === ' ') e.preventDefault();
  if (!e.repeat) juego.manejarTecla(e.key);
  teclas[e.key] = true;
});
document.addEventListener('keyup', (e) => { teclas[e.key] = false; });
document.querySelectorAll('.tactil button').forEach(b => {
  const k = b.dataset.tecla;
  b.addEventListener('pointerdown', (e) => { e.preventDefault(); encenderAudio(); teclas[k] = true; juego.manejarTecla(k); });
  for (const ev of ['pointerup', 'pointerleave', 'pointercancel']) b.addEventListener(ev, () => { teclas[k] = false; });
});
canvas.addEventListener('pointerdown', () => { encenderAudio(); if (juego.estado === 'batalla' || juego.mensajes.length || juego.estado === 'final') juego.manejarTecla('Enter'); });

let acumulado = 0;
let ultimoTiempo = performance.now();
function bucle(ahora) {
  let dt = ahora - ultimoTiempo;
  ultimoTiempo = ahora;
  if (dt > 250) dt = 250;      // si la pestaña estuvo escondida, no saltamos mil cuadros
  acumulado += dt;
  while (acumulado >= PASO) { juego.actualizar(DT); acumulado -= PASO; }
  juego.dibujar();
  requestAnimationFrame(bucle);
}
requestAnimationFrame(bucle);
