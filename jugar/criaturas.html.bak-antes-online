    } else if (ch === '~') {
      const fase = Math.sin(t * 2 + x + y * 0.7);
      linea(g, px + 6, cy + fase * 3, px + 18, cy + fase * 3, 'rgb(140,190,240)', 2);
      linea(g, px + 22, cy + 8 - fase * 3, px + 34, cy + 8 - fase * 3, 'rgb(140,190,240)', 2);
    } else if (',;"'.includes(ch)) {
      const color = { ',': 'rgb(90,160,70)', ';': 'rgb(50,130,50)', '"': 'rgb(30,90,40)' }[ch];
      const altoH = 8 + (ch === ';' ? 4 : ch === '"' ? 10 : 0);
