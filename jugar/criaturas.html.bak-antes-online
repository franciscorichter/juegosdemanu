class Lienzo {
  constructor(g, cx, cy, tam, mirando = 1) { this.g = g; this.cx = cx; this.cy = cy; this.r = tam / 2; this.m = mirando; }
  P(x, y) { return [this.cx + x * this.r * this.m, this.cy + y * this.r]; }
  circulo(color, x, y, radio, borde = 0) {
    const [px, py] = this.P(x, y), g = this.g;
    g.beginPath(); g.arc(px, py, Math.max(1, radio * this.r), 0, Math.PI * 2);
    if (borde) { g.strokeStyle = rgb(color); g.lineWidth = borde; g.stroke(); } else { g.fillStyle = rgb(color); g.fill(); }
  }
  elipse(color, x, y, ancho, alto) {
    const [px, py] = this.P(x, y), g = this.g;
    g.beginPath(); g.ellipse(px, py, Math.max(1, ancho * this.r / 2), Math.max(1, alto * this.r / 2), 0, 0, Math.PI * 2);
    g.fillStyle = rgb(color); g.fill();
  }
  poligono(color, puntos) {
    const g = this.g;
    g.beginPath();
    puntos.forEach(([x, y], i) => { const [px, py] = this.P(x, y); if (i === 0) g.moveTo(px, py); else g.lineTo(px, py); });
    g.closePath(); g.fillStyle = rgb(color); g.fill();
  }
  linea(color, a, b, grosor = 2) {
    const g = this.g, [x1, y1] = this.P(...a), [x2, y2] = this.P(...b);
    g.strokeStyle = rgb(color); g.lineWidth = Math.max(1, grosor * this.r / 40);
    g.beginPath(); g.moveTo(x1, y1); g.lineTo(x2, y2); g.stroke();
  }
  ojo(x, y, radio = 0.1, pupila = [20, 20, 30], enojado = false) {
    this.circulo([255, 255, 255], x, y, radio);
    this.circulo(pupila, x + 0.02, y + 0.02, radio * 0.55);
    this.circulo([255, 255, 255], x + 0.04, y - 0.03, radio * 0.2);
    if (enojado) this.linea([20, 20, 30], [x - radio, y - radio * 1.3], [x + radio, y - radio * 0.6], 3);
  }
  boca(x, y, ancho = 0.2, feliz = true) {
    const [px, py] = this.P(x, y), g = this.g;
    const w = ancho * this.r / 2, h = 0.12 * this.r / 2;
    g.strokeStyle = 'rgb(20,20,30)'; g.lineWidth = Math.max(1, this.r / 25);
