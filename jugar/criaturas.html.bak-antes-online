<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Criaturas de Manu</title>
<style>
  /* Colores de la página (style.css) */
  :root {
    --pasto: #5d9a3c; --pasto-oscuro: #3e6b28; --piedra: #7f7f7f; --piedra-oscura: #4f4f4f;
    --cielo: #7fb2f0; --diamante: #4aedd9; --texto: #ffffff; --sombra: #1a1a1a;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0; min-height: 100vh; padding: 16px;
    background: var(--sombra); color: var(--texto);
    font-family: 'Press Start 2P', 'Courier New', monospace; font-size: 12px; line-height: 1.8;
    display: flex; flex-direction: column; align-items: center;
  }
  h1 { font-size: 18px; color: var(--diamante); text-shadow: 3px 3px 0 #000; margin: 8px 0 12px; text-align: center; }
  canvas {
    display: block; max-width: 100%; height: auto; background: #000;
    border: 4px solid var(--piedra-oscura); box-shadow: 6px 6px 0 #000;
    touch-action: none;
  }
  .ayuda { font-size: 9px; color: #dddddd; text-align: center; max-width: 640px; margin: 10px 0 0; }
  .boton {
    display: inline-block; margin: 16px 0; padding: 12px 16px; font-size: 11px;
    background: #3c6ec9; border: 4px solid #244a8c; box-shadow: 4px 4px 0 #000;
    color: var(--texto); text-decoration: none; text-shadow: 2px 2px 0 #000;
  }
  .boton:hover { background: #4a82e0; }
  .boton:active { transform: translate(2px, 2px); box-shadow: 2px 2px 0 #000; }
  /* Botones de celular: solo aparecen en pantallas táctiles */
  .tactil { display: none; gap: 10px; margin-top: 12px; width: 100%; max-width: 960px; justify-content: space-between; align-items: center; }
  @media (pointer: coarse) { .tactil { display: flex; } }
  .cruz { display: grid; grid-template-columns: repeat(3, 56px); grid-template-rows: repeat(3, 56px); gap: 4px; }
  .tactil button {
    font-family: inherit; font-size: 14px; width: 56px; height: 56px;
    background: var(--piedra-oscura); border: 4px solid #000; color: var(--texto);
    box-shadow: 4px 4px 0 #000; touch-action: none; user-select: none;
  }
  .tactil button:active { background: var(--piedra); }
  .tactil .grande { width: 80px; }
</style>
</head>
<body>
<h1>CRIATURAS</h1>
<canvas id="juego" width="960" height="640"></canvas>
<div class="tactil">
  <div class="cruz">
    <span></span><button data-tecla="ArrowUp">▲</button><span></span>
    <button data-tecla="ArrowLeft">◀</button><span></span><button data-tecla="ArrowRight">▶</button>
    <span></span><button data-tecla="ArrowDown">▼</button><span></span>
  </div>
  <div style="display:flex;gap:10px"><button class="grande" data-tecla="Escape">ESC</button><button class="grande" data-tecla="Enter">OK</button></div>
</div>
<p class="ayuda">flechas: caminar / moverse por los menús &middot; ENTER: aceptar / hablar &middot; ESC: cancelar / menú &middot; SHIFT: correr &middot; G / L: guardar / cargar</p>
<a class="boton" href="../index.html">&larr; Volver a la página</a>

<script>
// ============================================================
//  Criaturas — versión web del criaturas.py de Manu
//  (datos.py + logica.py + dibujos.py + criaturas.py en un solo archivo)
//  Todo se dibuja con canvas. Sin imágenes, sin internet.
// ============================================================

// ================= DATOS (datos.py) =================
const COLOR_TIPO = {
  fuego: [235, 90, 40], agua: [60, 130, 230], planta: [70, 180, 80], electrico: [240, 210, 40],
  roca: [160, 130, 90], fantasma: [130, 90, 190], normal: [170, 170, 170],
};
const NOMBRE_TIPO = { fuego: 'Fuego', agua: 'Agua', planta: 'Planta', electrico: 'Eléctrico', roca: 'Roca', fantasma: 'Fantasma', normal: 'Normal' };
// EFECTIVIDAD[tipo_del_ataque][tipo_del_que_recibe]: 2 = súper efectivo, 0.5 = poco, 1 = normal
const EFECTIVIDAD = {
  fuego: { planta: 2, agua: 0.5, roca: 0.5, fuego: 0.5 },
  agua: { fuego: 2, roca: 2, agua: 0.5, planta: 0.5 },
  planta: { agua: 2, roca: 2, fuego: 0.5, planta: 0.5 },
  electrico: { agua: 2, planta: 0.5, roca: 0.5, electrico: 0.5 },
  roca: { fuego: 2, electrico: 2, planta: 0.5, agua: 0.5 },
  fantasma: { fantasma: 2, roca: 0.5, electrico: 0.5 },
  normal: { roca: 0.5, fantasma: 0.5 },
};
const efectividad = (a, d) => (EFECTIVIDAD[a] || {})[d] ?? 1;

// poder 0 = no hace daño, solo el efecto. efecto: null, 'dormir', 'veneno' o 'subir_ataque'
const A = (tipo, poder, precision, efecto = null) => ({ tipo, poder, precision, efecto });
const ATAQUES = {
  'Golpe': A('normal', 40, 100), 'Embestida': A('normal', 55, 95), 'Arañazo': A('normal', 40, 100),
  'Chispa': A('fuego', 40, 100), 'Llamarada': A('fuego', 65, 90), 'Erupción': A('fuego', 90, 80), 'Rugido Ardiente': A('fuego', 0, 100, 'subir_ataque'),
  'Burbuja': A('agua', 40, 100), 'Chorro': A('agua', 65, 90), 'Tsunami': A('agua', 90, 80), 'Canción de Marea': A('agua', 0, 70, 'dormir'),
  'Hoja Filosa': A('planta', 45, 100), 'Látigo Verde': A('planta', 65, 90), 'Raíz Gigante': A('planta', 90, 80), 'Polen Tóxico': A('planta', 0, 80, 'veneno'),
  'Chispazo': A('electrico', 40, 100), 'Rayo': A('electrico', 65, 90), 'Trueno': A('electrico', 90, 80), 'Carga Eléctrica': A('electrico', 0, 100, 'subir_ataque'),
  'Pedrada': A('roca', 45, 100), 'Derrumbe': A('roca', 65, 90), 'Avalancha': A('roca', 90, 80), 'Arena Somnífera': A('roca', 0, 70, 'dormir'),
  'Susurro': A('fantasma', 40, 100), 'Garra Sombría': A('fantasma', 65, 90), 'Pesadilla': A('fantasma', 90, 80), 'Maldición': A('fantasma', 0, 85, 'veneno'),
};

const NIVEL_EVOLUCION = 16;
// stats base: hp, ataque, defensa, velocidad. captura: 1.0 fácil, 0.3 difícil. ataques: [nombre, nivel en que lo aprende]
const E = (tipo, hp, ataque, defensa, velocidad, captura, exp_base, evoluciona, ataques, descripcion) =>
  ({ tipo, hp, ataque, defensa, velocidad, captura, exp_base, evoluciona, ataques, descripcion });
const ESPECIES = {
  'Brasita': E('fuego', 42, 55, 40, 60, 0.9, 60, ['Volcanor', NIVEL_EVOLUCION], [['Golpe', 1], ['Chispa', 1], ['Rugido Ardiente', 5], ['Llamarada', 10]], 'Una brasa con patitas. Si se enoja, echa humo.'),
  'Volcanor': E('fuego', 70, 85, 60, 80, 0.3, 150, null, [['Golpe', 1], ['Llamarada', 1], ['Rugido Ardiente', 1], ['Erupción', 20]], 'Tiene un cráter en la cabeza que hierve todo el día.'),
  'Gotix': E('agua', 50, 45, 50, 50, 0.9, 60, ['Marejón', NIVEL_EVOLUCION], [['Golpe', 1], ['Burbuja', 1], ['Canción de Marea', 5], ['Chorro', 10]], 'Una gota gigante que rebota. Canta cuando llueve.'),
  'Marejón': E('agua', 85, 70, 75, 65, 0.3, 150, null, [['Embestida', 1], ['Chorro', 1], ['Canción de Marea', 1], ['Tsunami', 20]], 'Una ola con cara. Puede tragarse un bote entero.'),
  'Brotín': E('planta', 48, 48, 55, 42, 0.9, 60, ['Selvarak', NIVEL_EVOLUCION], [['Arañazo', 1], ['Hoja Filosa', 1], ['Polen Tóxico', 5], ['Látigo Verde', 10]], 'Un brote que caminó fuera de la maceta.'),
  'Selvarak': E('planta', 80, 78, 85, 50, 0.3, 150, null, [['Arañazo', 1], ['Látigo Verde', 1], ['Polen Tóxico', 1], ['Raíz Gigante', 20]], 'Un árbol enojado. Sus raíces atrapan cualquier cosa.'),
  'Chispín': E('electrico', 38, 52, 35, 75, 0.8, 65, ['Tormentux', NIVEL_EVOLUCION], [['Golpe', 1], ['Chispazo', 1], ['Carga Eléctrica', 5], ['Rayo', 10]], 'Una chispa con orejas. Nunca se queda quieto.'),
  'Tormentux': E('electrico', 65, 85, 55, 100, 0.3, 155, null, [['Embestida', 1], ['Rayo', 1], ['Carga Eléctrica', 1], ['Trueno', 20]], 'Una nube de tormenta con ojos. Truena al respirar.'),
  'Pedrolo': E('roca', 55, 50, 70, 25, 0.8, 70, ['Montaraz', NIVEL_EVOLUCION], [['Golpe', 1], ['Pedrada', 1], ['Arena Somnífera', 5], ['Derrumbe', 10]], 'Una piedra que parpadea. Le gusta dormir siglos.'),
  'Montaraz': E('roca', 90, 80, 110, 35, 0.3, 160, null, [['Embestida', 1], ['Derrumbe', 1], ['Arena Somnífera', 1], ['Avalancha', 20]], 'Una montañita con brazos. Casi nada la mueve.'),
  'Sombrilo': E('fantasma', 40, 55, 40, 65, 0.6, 70, ['Espectrum', NIVEL_EVOLUCION], [['Arañazo', 1], ['Susurro', 1], ['Maldición', 5], ['Garra Sombría', 10]], 'Una sombra traviesa. Se esconde debajo de las camas.'),
  'Espectrum': E('fantasma', 65, 90, 60, 90, 0.25, 160, null, [['Arañazo', 1], ['Garra Sombría', 1], ['Maldición', 1], ['Pesadilla', 20]], 'Un fantasma con corona. Dicen que fue rey de algo.'),
};
const BASICAS = Object.keys(ESPECIES).filter(n => ESPECIES[n].evoluciona !== null);
const EVOLUCIONADAS = Object.keys(ESPECIES).filter(n => ESPECIES[n].evoluciona === null);
const INICIALES = ['Brasita', 'Gotix', 'Brotín'];

const OBJETOS = {
  'Poción': { tipo: 'curar', valor: 20, descripcion: 'Cura 20 de vida.' },
  'Superpoción': { tipo: 'curar', valor: 50, descripcion: 'Cura 50 de vida.' },
  'Esfera': { tipo: 'esfera', valor: 1.0, descripcion: 'Atrapa criaturas salvajes.' },
  'Superesfera': { tipo: 'esfera', valor: 1.6, descripcion: 'Atrapa mejor que la Esfera.' },
  'Antídoto': { tipo: 'estado', valor: 0, descripcion: 'Quita veneno y despierta.' },
};
const MOCHILA_INICIAL = { 'Poción': 4, 'Esfera': 6, 'Superesfera': 1, 'Antídoto': 1 };
// letra del mapa -> [nivel mínimo, nivel máximo, especies]
const PASTO = { ',': [3, 6, BASICAS], ';': [8, 12, BASICAS], '"': [13, 18, [...BASICAS, ...EVOLUCIONADAS]] };
const PROB_ENCUENTRO = 0.14;

const ENTRENADORES = {
  '1': { nombre: 'Lía la Jardinera', equipo: [['Brotín', 6], ['Gotix', 7]], antes: '¡Mis plantitas te van a enredar!', despues: 'Uy... les faltó sol.', premio: { 'Poción': 2 } },
  '2': { nombre: 'Tomás el Minero', equipo: [['Pedrolo', 10], ['Chispín', 11], ['Pedrolo', 12]], antes: '¡Aquí abajo mandan las rocas!', despues: 'Qué golpe... bien jugado.', premio: { 'Superpoción': 2, 'Esfera': 3 } },
  '3': { nombre: 'Nadia la Nocturna', equipo: [['Sombrilo', 14], ['Brasita', 14], ['Sombrilo', 15]], antes: 'Shhh... ¿escuchas los susurros?', despues: 'Los fantasmas también pierden, parece.', premio: { 'Superesfera': 2, 'Antídoto': 2 } },
  'K': { nombre: 'Campeón Orión', equipo: [['Tormentux', 17], ['Selvarak', 18], ['Volcanor', 18], ['Espectrum', 19]], antes: 'Venciste a los tres. Ahora veamos si puedes conmigo.', despues: '...Increíble. Eres el nuevo campeón.', premio: { 'Superesfera': 5 } },
};

// El mapa (copiado de mapa.txt). Cada letra es una casilla:
//   #  árbol   ~  agua   H  casa   .  camino   +  centro de curación   L  letrero
//   , ; "  pasto bajo / medio / alto   P  donde empiezas   1 2 3  entrenadores   K  el campeón
const MAPA_TXT = `
############################################
#............#~~~~~~#......................#
#.HH.........#~~~~~~#..,,,,,,,,,,..HH......#
#.HH...+.....#~~~~~~#..,,,,,,,,,,..HH......#
#..L...L.....#~~~~~~#..,,,,,,,,,,....L.....#
#.P..........#~~~~~~#..,,,,,,,,,,..........#
#............###..###.......1..............#
#.,,,,,,,,.........................######..#
#.,,,,,,,,.....###########.........#;;;;#..#
#.,,,,,,,,.....#;;;;;;;;;#....HH...#;;;;#..#
#.,,,,,,,,.....#;;;;;;;;;#....HH...#;;;;#..#
#..............#;;;;;;;;;#.........#;;;;#..#
#.............L#;;;;;;;;;#.....2...#;;;;#..#
######..#######;;;;;;;;;;;.................#
#......................;;;;;;;;;;..........#
#.HH..........#~~~~~#..;;;;;;;;;;..........#
#.HH.....+....#~~~~~#..............L.......#
#........L....#~~~~~#........###########...#
#.............#~~~~~#........#"""""""""#...#
#.........,,,,#~~~~~#........#"""""""""#...#
#.........,,,,#~~~~~~~~~~~~~~#"""""""""#...#
#.........,,,,#~~~~~~~~~~~~~~#"""""""""#...#
#.............#..............#""""3""""#...#
#.............L..........................L.#
#.............#..............#####.#####...#
#..HHHH.......#..............#.........#...#
#..HHHH.......#..............#....K....#...#
#..HHHH.......#..............#.........#...#
#.............#..............###########...#
############################################
`;

// ================= LÓGICA (logica.py) =================
const MAX_EQUIPO = 6;
const expParaNivel = (nivel) => nivel ** 3;
const azarEntre = (a, b) => a + Math.random() * (b - a);
const azarEntero = (a, b) => Math.floor(azarEntre(a, b + 1));
const elegir = (l) => l[Math.floor(Math.random() * l.length)];
const trunc = Math.trunc;

class Criatura {
  constructor(especie, nivel, apodo = null) {
    if (!(especie in ESPECIES)) throw new Error('No existe la criatura ' + especie);
    this.especie = especie; this.nivel = nivel; this.exp = expParaNivel(nivel); this.apodo = apodo;
    this.ataques = this.ataquesConocidos();
    this.hp = this.hpMax;
    this.estado = null;          // null, 'dormido' o 'envenenado'
    this.turnosDormido = 0;
    this.etapaAtaque = 0;        // de 0 a 6: cuánto subió el ataque en esta batalla
  }
  ataquesConocidos() { return ESPECIES[this.especie].ataques.filter(([, nv]) => nv <= this.nivel).map(([n]) => n); }
  get datos() { return ESPECIES[this.especie]; }
  get nombre() { return this.apodo || this.especie; }
  get tipo() { return this.datos.tipo; }
  stat(n) { return trunc(this.datos[n] * 2 * this.nivel / 100) + 5; }
  get hpMax() { return trunc(this.datos.hp * 3 * this.nivel / 100) + this.nivel + 12; }
  get ataque() { return trunc(this.stat('ataque') * (1 + 0.5 * this.etapaAtaque)); }
  get defensa() { return this.stat('defensa'); }
  get velocidad() { return this.stat('velocidad'); }
  get ko() { return this.hp <= 0; }
  danar(c) { this.hp = Math.max(0, this.hp - trunc(c)); }
  curar(c) { const antes = this.hp; this.hp = Math.min(this.hpMax, this.hp + trunc(c)); return this.hp - antes; }
  curarTodo() { this.hp = this.hpMax; this.estado = null; this.turnosDormido = 0; }
  terminarBatalla() { this.etapaAtaque = 0; }
  // Suma experiencia. Devuelve eventos: ['nivel', n], ['aprende', ataque], ['evolucion', antes, despues]
  ganarExp(cantidad) {
    const eventos = [];
    this.exp += trunc(cantidad);
    while (this.nivel < 100 && this.exp >= expParaNivel(this.nivel + 1)) {
      const hpAntes = this.hpMax;
      this.nivel += 1;
      this.hp += this.hpMax - hpAntes;
      eventos.push(['nivel', this.nivel]);
      for (const [nombre, nv] of this.datos.ataques) if (nv === this.nivel && !this.ataques.includes(nombre)) { this.ataques.push(nombre); eventos.push(['aprende', nombre]); }
      const evo = this.datos.evoluciona;
      if (evo !== null && this.nivel >= evo[1]) { const antes = this.especie; this.evolucionar(); eventos.push(['evolucion', antes, this.especie]); }
    }
    return eventos;
  }
  evolucionar() {
    const evo = this.datos.evoluciona;
    if (evo === null) return false;
    const hpAntes = this.hpMax;
    if (this.apodo === this.especie) this.apodo = null;
    this.especie = evo[0];
    this.ataques = this.ataquesConocidos();
    this.hp += this.hpMax - hpAntes;
    return true;
  }
  expSiguiente() { const base = expParaNivel(this.nivel), tope = expParaNivel(this.nivel + 1); return [this.exp - base, tope - base]; }
  aDict() { return { especie: this.especie, nivel: this.nivel, exp: this.exp, apodo: this.apodo, hp: this.hp, estado: this.estado, ataques: this.ataques }; }
  static desdeDict(d) {
    const c = new Criatura(d.especie, d.nivel, d.apodo || null);
    c.exp = d.exp ?? c.exp; c.hp = Math.min(d.hp ?? c.hpMax, c.hpMax); c.estado = d.estado || null; c.ataques = [...(d.ataques || c.ataques)];
    return c;
  }
}

// Devuelve [daño, efectividad, fueCritico]. Fórmula parecida a la de los juegos de rol.
function calcularDano(atacante, defensor, nombreAtaque) {
  const at = ATAQUES[nombreAtaque];
  if (at.poder === 0) return [0, 1, false];
  const base = (2 * atacante.nivel / 5 + 2) * at.poder * atacante.ataque / Math.max(1, defensor.defensa) / 50 + 2;
  const mismoTipo = at.tipo === atacante.tipo ? 1.5 : 1;
  const efe = efectividad(at.tipo, defensor.tipo);
  const critico = Math.random() < 1 / 16;
  const ventaja = Math.max(0.6, Math.min(1.6, Math.sqrt(atacante.nivel / Math.max(1, defensor.nivel))));
  const dano = base * mismoTipo * efe * ventaja * (critico ? 1.5 : 1) * azarEntre(0.85, 1);
  return [Math.max(1, trunc(dano)), efe, critico];
}
function probabilidadCaptura(c, esfera = 'Esfera') {
  const vida = (3 * c.hpMax - 2 * c.hp) / (3 * c.hpMax);
  const bonoEstado = { dormido: 2, envenenado: 1.5 }[c.estado] || 1;
  return Math.min(1, vida * ESPECIES[c.especie].captura * OBJETOS[esfera].valor * bonoEstado * 0.85);
}
function expPorVencer(vencida, contraEntrenador) {
  return trunc(ESPECIES[vencida.especie].exp_base * vencida.nivel / 7 * (contraEntrenador ? 1.5 : 1)) + 1;
}

class Mochila {
  constructor(contenido = null) { this.objetos = { ...(contenido || MOCHILA_INICIAL) }; }
  tiene(n) { return (this.objetos[n] || 0) > 0; }
  agregar(n, c = 1) { this.objetos[n] = (this.objetos[n] || 0) + c; }
  quitar(n) { if (!this.tiene(n)) return false; this.objetos[n] -= 1; if (this.objetos[n] === 0) delete this.objetos[n]; return true; }
  lista() { return Object.entries(this.objetos).filter(([, c]) => c > 0); }
}

// Una batalla entre tu equipo y un enemigo. Cada turno devuelve eventos que la pantalla muestra uno por uno.
class Batalla {
  constructor(equipo, mochila, enemigos, entrenador = null, caja = null) {
    this.equipo = equipo; this.mochila = mochila; this.enemigos = enemigos;
    this.entrenador = entrenador; this.salvaje = entrenador === null;
    this.caja = caja || [];
    this.activa = equipo.findIndex(c => !c.ko);
    this.enemigoI = 0; this.terminada = false; this.resultado = null; this.intentosHuir = 0; this.capturada = null;
  }
  get mia() { return this.equipo[this.activa]; }
  get enemiga() { return this.enemigos[this.enemigoI]; }
  criatura(lado) { return lado === 'jugador' ? this.mia : this.enemiga; }
  otro(lado) { return lado === 'jugador' ? 'enemigo' : 'jugador'; }
  eventosInicio() {
    const ev = [];
    if (this.salvaje) ev.push(['msg', '¡Apareció un ' + this.enemiga.nombre + ' salvaje!']);
    else {
      ev.push(['msg', '¡' + this.entrenador.nombre + ' quiere pelear!']);
      ev.push(['msg', this.entrenador.nombre + ': ' + this.entrenador.antes]);
      ev.push(['sale', 'enemigo']);
      ev.push(['msg', this.entrenador.nombre + ' saca a ' + this.enemiga.nombre + '.']);
    }
    ev.push(['sale', 'jugador']);
    ev.push(['msg', '¡Adelante, ' + this.mia.nombre + '!']);
    return ev;
  }
  necesitaCambio() { return this.mia.ko && this.equipo.some(c => !c.ko); }
  // accion: ['atacar', i] / ['objeto', nombre, indiceCriatura] / ['cambiar', i] / ['huir']
  turno(accion) {
    if (this.terminada) return [];
    let ev = [];
    const tipo = accion[0];
    if (this.mia.ko) { if (tipo === 'cambiar') ev = ev.concat(this.cambiar(accion[1])); return ev; }
    let enemigoAtaca = true;
    if (tipo === 'huir') {
      if (!this.salvaje) { ev.push(['msg', '¡No puedes huir de un entrenador!']); return ev; }
      this.intentosHuir += 1;
      const prob = 0.5 + 0.1 * this.intentosHuir + (this.mia.velocidad >= this.enemiga.velocidad ? 0.2 : 0);
      if (Math.random() < prob) { ev.push(['msg', '¡Escapaste sin problemas!']); return ev.concat(this.terminar('huida')); }
      ev.push(['msg', '¡No pudiste escapar!']);
    } else if (tipo === 'objeto') {
      const [evObj, gastaTurno] = this.usarObjeto(accion[1], accion.length > 2 ? accion[2] : this.activa);
      ev = ev.concat(evObj);
      if (this.terminada || !gastaTurno) return ev;
    } else if (tipo === 'cambiar') {
      ev = ev.concat(this.cambiar(accion[1]));
    } else if (tipo === 'atacar') {
      const nombre = this.mia.ataques[accion[1]];
      const atEnemigo = this.elegirAtaqueEnemigo();
      const yoPrimero = this.mia.velocidad > this.enemiga.velocidad || (this.mia.velocidad === this.enemiga.velocidad && Math.random() < 0.5);
      const orden = [['jugador', nombre], ['enemigo', atEnemigo]];
