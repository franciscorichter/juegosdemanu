  }
  duracion(ev) { return { sacudida: 0.4, parpadeo: 0.45, hp: 0.6, ko: 0.6, sale: 0.4, exp: 0.6, fin: 0.3 }[ev[0]] || 0; }
  actualizar(dt) {
    this.t += dt;
