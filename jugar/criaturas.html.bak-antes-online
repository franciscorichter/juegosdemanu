// ---------- El juego completo ----------
class Juego {
  constructor() {
    this.mapa = new Mapa(MAPA_TXT);
    this.partida = new Partida();
    this.estado = 'titulo';
    this.menu = new Menu(['Nueva partida', 'Continuar (L)', 'Borrar partida guardada']);
    this.menuInicial = new Menu(INICIALES);
    this.menuPausa = new Menu(['Criaturas', 'Mochila', 'Guardar (G)', 'Cargar (L)', 'Seguir jugando', 'Volver al título']);
    this.menuEquipo = new Menu([]); this.menuMochila = new Menu([]);
    this.intercambio = null; this.objetoElegido = null;
    [this.x, this.y] = this.mapa.inicio;
    this.mirando = [0, 1]; this.pasoTimer = 0; this.mensajes = [];
    this.batalla = null; this.batallaLetra = null; this.transicion = 0; this.batallaPendiente = null;
    this.t = 0; this.aviso = ['', 0];
    this.puntoCuracion = this.mapa.centros.length ? this.mapa.centros[0] : this.mapa.inicio;
    this.fondos = {};
  }
  nuevaPartida(inicial) {
    this.partida = new Partida();
    this.partida.equipo = [new Criatura(inicial, 5)];
    [this.x, this.y] = this.mapa.inicio;
    this.partida.pos = [this.x, this.y];
    this.estado = 'mapa';
    this.mensajes = ['¡' + inicial + ' es tu primera criatura! Al norte hay pasto bajo para practicar.', 'ENTER habla y avanza el texto. ESC abre el menú. G guarda.'];
  }
  guardar() {
    this.partida.pos = [this.x, this.y];
    try { localStorage.setItem('criaturas-partida', JSON.stringify(this.partida.aDict())); this.aviso = ['Partida guardada en el navegador', 2]; sonar('curar'); }
    catch (e) { this.aviso = ['No se pudo guardar', 3]; }
  }
  cargar() {
    let d = null;
    try { d = JSON.parse(localStorage.getItem('criaturas-partida')); } catch (e) {}
    if (!d) { this.aviso = ['No hay partida guardada todavía.', 2]; return false; }
    try { this.partida = Partida.desdeDict(d); } catch (e) { this.aviso = ['No se pudo cargar', 3]; return false; }
    if (this.partida.pos && !this.mapa.solida(...this.partida.pos)) [this.x, this.y] = this.partida.pos; else [this.x, this.y] = this.mapa.inicio;
    if (!this.partida.equipo.length) this.partida.equipo = [new Criatura(INICIALES[0], 5)];
