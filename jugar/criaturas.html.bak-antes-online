// ---------- El mapa ----------
class Mapa {
  constructor(txt) {
    const filas = txt.split('\n').filter(l => l.trim() && !l.startsWith('//'));
    const ancho = Math.max(...filas.map(f => f.length));
    this.filas = filas.map(f => f.padEnd(ancho, '#'));
    this.alto = this.filas.length; this.ancho = ancho;
    this.inicio = [1, 1]; this.entrenadores = {}; this.letreros = new Map(); this.centros = [];
    let nLetrero = 0;
    this.filas.forEach((fila, y) => [...fila].forEach((ch, x) => {
      if (ch === 'P') this.inicio = [x, y];
      else if ('123K'.includes(ch)) this.entrenadores[ch] = [x, y];
      else if (ch === 'L') { this.letreros.set(x + ',' + y, LETREROS[nLetrero % LETREROS.length]); nLetrero++; }
      else if (ch === '+') this.centros.push([x, y]);
    }));
    // decoración fija (florcitas): un número "al azar" pero siempre igual por casilla
    this.flores = (x, y) => { const s = Math.sin(x * 131 + y * 17) * 10000; return s - Math.floor(s); };
  }
  casilla(x, y) { return (y >= 0 && y < this.alto && x >= 0 && x < this.ancho) ? this.filas[y][x] : '#'; }
  solida(x, y) { return SOLIDOS.has(this.casilla(x, y)); }
  dibujar(g, camX, camY, t, vencidos) {
    const c0 = Math.max(0, trunc(camX / TILE)), f0 = Math.max(0, trunc(camY / TILE));
    for (let y = f0; y < Math.min(this.alto, f0 + ALTO / TILE + 2); y++) for (let x = c0; x < Math.min(this.ancho, c0 + ANCHO / TILE + 2); x++) {
      const ch = this.casilla(x, y), px = x * TILE - camX, py = y * TILE - camY;
      rect(g, px, py, TILE, TILE, COLOR_TILE[ch] || 'rgb(200,200,200)');
      this.decorar(g, ch, x, y, px, py, t);
    }
    for (const [letra, [x, y]] of Object.entries(this.entrenadores)) {
      dibujarPersona(g, x * TILE - camX + TILE / 2, y * TILE - camY + TILE / 2, [200, 60, 60], letra === 'K', vencidos.includes(letra), t);
    }
  }
  decorar(g, ch, x, y, px, py, t) {
    const cx = px + TILE / 2, cy = py + TILE / 2, azar = this.flores(x, y);
