      const at = ATAQUES[nombre];
      if (at.poder === 0) {
        const ya = (at.efecto === 'subir_ataque' && e.etapaAtaque >= 2) || ((at.efecto === 'dormir' || at.efecto === 'veneno') && this.mia.estado !== null);
